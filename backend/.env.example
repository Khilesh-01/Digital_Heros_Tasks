# Copy this file to .env and adjust as needed. Every value has a safe default
# in app/core/config.py, so .env is optional for local development.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# HTTP client behaviour
REQUEST_TIMEOUT_SECONDS=10.0
CONNECT_TIMEOUT_SECONDS=5.0
MAX_REDIRECTS=5
MAX_RESPONSE_BYTES=5000000
USER_AGENT=PagePulseBot/1.0 (+https://digitalheroesco.com)
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=0.5

# Security
# Set to true ONLY for local testing against localhost targets.
ALLOW_PRIVATE_NETWORK_TARGETS=false
ALLOWED_SCHEMES=http,https
