{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        },
        "backend": {
            "root": "backend"
        }
    },
    "rewrites": [
        {
            "source": "/audit",
            "destination": "/backend/app/main.py"
        },
        {
            "source": "/health",
            "destination": "/backend/app/main.py"
        },
        {
            "source": "/docs",
            "destination": "/backend/app/main.py"
        },
        {
            "source": "/redoc",
            "destination": "/backend/app/main.py"
        },
        {
            "source": "/openapi.json",
            "destination": "/backend/app/main.py"
        },
        {
            "source": "/api(/.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}